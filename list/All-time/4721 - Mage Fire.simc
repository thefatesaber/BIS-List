# Engine of record : BracketSim (https://bracketsim.gg) — SimulationCraft 1210-01
#                    git e40a6d0, WoW 12.1.5.70575 hotfix 2026-10-28
# Result           : 4,721 DPS (±0.8 / 0.017%), 20015 iterations
#                    Patchwerk 300s, fixed length (vary_combat_length=0)
# Report           : 4721 - Mage Fire.html (same folder; /r/ share links expire)
# Simmed           : 2026-10-29 by Fate
#
# BracketSim options (the full-buffed set of PROJECT.md; BracketSim hides buffs
# the class cannot use, so the visible list varies by class):
#   Raid buff preset: Optimal Raid Buffs
#   World buffs:   [x] Flame Cap  [ ] Fengus' Ferocity  [ ] Slip'kik's Savvy
#                  [ ] Icecrown Citadel  [ ] Plague Stream
#                  [ ] Adventurer's Journal
#   Raid buffs:    [x] Arcane Intellect  [ ] Battle Shout
#                  [x] Mark of the Wild  [x] Skyfury  [x] Drums of Fury
#                  [x] Hunter's Mark  [ ] Blessing of the Bronze
#                  [ ] Power Word: Fortitude  [ ] Chaos Brand
#                  [ ] Mystic Touch  [ ] Bleeding  [ ] Power Infusion
#   Teammate armor reduction: none
#   Misc:          [x] Detailed SimC Report   [ ] Vary fight length
#                  [ ] Augmentation Evoker    [x] Stat weights
#
# Stat weights (DPS): Int 12.32 > SP 11.58 > Haste 6.94 > Vers 6.38 > Mastery 5.59 > Crit 2.99
# ============================================================================

mage="Fateccaster"
source=default
region=us
server=thrall
spec=fire
level=30
race=nightborne
role=spell
position=back
professions=enchanting=60/inscription=25
talents=C8DAche08tHz49KSVf7iKFnyuBgxAmZkBAAAAAAAAAwMDYMDAAAAAwGYGAAAAGDLAAAAMAA

# Default consumables
potion=volcanic_potion
flask=flask_of_distilled_wisdom
elixir=disabled
food=severed_sagefish_head
augmentation=disabled
temporary_enchant=main_hand:superior_wizard_oil

# Executed before combat begins. Accepts non-harmful actions only.
actions.precombat=arcane_intellect
actions.precombat+=/variable,name=hardcast_aoe_threshold,value=4
actions.precombat+=/variable,name=hardcast_aoe_threshold_low,value=11
actions.precombat+=/variable,name=hot_streak_aoe_threshold,value=3
actions.precombat+=/variable,name=combustion_meteor_delay,value=1
actions.precombat+=/variable,name=meteor_combustion_delay,value=25
actions.precombat+=/snapshot_stats
actions.precombat+=/pyroblast

# Executed every time the actor is available.
actions=variable,name=hold_hot_streak,value=10-(((fight_remains-10-cooldown.combustion.remains)%%62)%floor(fight_remains-10-cooldown.combustion.remains)%62)
actions+=/use_item,name=flame_cap,if=cooldown.combustion.remains<40,use_off_gcd=1
actions+=/potion,if=buff.combustion.up|(target.health.pct>90&talent.firestarter.enabled)|target.time_to_die<25,use_off_gcd=1
actions+=/combustion,if=buff.hot_streak.up&(!buff.combustion.up)&target.health.pct<=90&(!talent.meteor.enabled|(action.meteor.in_flight_remains<0.1&action.meteor.in_flight_remains>0)|(cooldown.meteor.remains>variable.combustion_meteor_delay&action.meteor.in_flight_remains=0)),use_off_gcd=1,use_while_casting=1
actions+=/use_items,if=buff.combustion.up|(target.health.pct>90&talent.firestarter.enabled),use_off_gcd=1,use_while_casting=1
actions+=/blood_fury,if=buff.combustion.up|(target.health.pct>90&talent.firestarter.enabled),use_off_gcd=1,use_while_casting=1
actions+=/berserking,if=buff.combustion.up|(target.health.pct>90&talent.firestarter.enabled),use_off_gcd=1,use_while_casting=1
actions+=/fireblood,if=buff.combustion.up|(target.health.pct>90&talent.firestarter.enabled),use_off_gcd=1,use_while_casting=1
actions+=/ancestral_call,if=buff.combustion.up|(target.health.pct>90&talent.firestarter.enabled),use_off_gcd=1,use_while_casting=1
actions+=/use_item,name=pendant_of_the_violet_eye,if=cooldown.combustion.remains<8,use_off_gcd=1,use_while_casting=1
actions+=/use_item,name=meteorite_crystal,if=cooldown.combuastion.remains<4,use_off_gcd=1,use_while_casting=1
actions+=/meteor,if=cooldown.meteor.ready&(((buff.combustion.up&buff.combustion.remains>2))|cooldown.combustion.remains>variable.meteor_combustion_delay|(cooldown.combustion.remains<2&buff.hot_streak.up&!(target.health.pct>90&talent.firestarter.enabled)))
actions+=/flamestrike,if=buff.hot_streak.up&active_enemies>=variable.hot_streak_aoe_threshold&!(cooldown.combustion.remains<variable.hold_hot_streak&!(target.health.pct>90&talent.firestarter.enabled))
actions+=/pyroblast,if=buff.hot_streak.up&!(cooldown.combustion.remains<variable.hold_hot_streak&!(target.health.pct>90&talent.firestarter.enabled))
actions+=/fire_blast,if=cooldown.fire_blast.charges>=2,use_off_gcd=1,use_while_casting=1
actions+=/fire_blast,if=buff.heating_up.up&!buff.hot_streak.up&!(action.scorch.executing&buff.heating_up.up),use_off_gcd=1,use_while_casting=1
actions+=/flamestrike,if=((((target.health.pct<30&(talent.scorch.enabled|talent.scald.enabled))|buff.heat_shimmer.up)&!buff.heating_up.up&active_enemies>=variable.hardcast_aoe_threshold_low)|(!((target.health.pct<30&(talent.scorch.enabled|talent.scald.enabled))|buff.heat_shimmer.up)&active_enemies>=variable.hardcast_aoe_threshold))
actions+=/scorch,if=target.health.pct<30|buff.heat_shimmer.up
actions+=/fireball

