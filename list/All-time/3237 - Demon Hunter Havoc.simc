finger1=fleshfused_circle,id=178869,bonus_id=6652/6710/10386/10396/10879,ilevel=33,gem_id=71852/71852,enchant_id=6110,drop_level=30
finger2=seal_of_the_city_watch,id=162542,bonus_id=6652/6710/10386/10396/10879,ilevel=33,gem_id=71852/71852,enchant_id=6110,drop_level=30
trinket1=dragonspine_trophy,id=28830,bonus_id=9034,ilevel=38,drop_level=30
