# ============================================================================
# Legacy Thirty BiS — All-time — Havoc Demon Hunter
# ----------------------------------------------------------------------------
# Engine of record : BracketSim (https://bracketsim.gg) — SimulationCraft 1210-01
#                    git e40a6d0, WoW 12.1.5.70575 hotfix 2026-10-28
# Result           : 3,237 DPS (±1.5 / 0.046%), 20015 iterations
#                    Patchwerk 300s, fixed length (vary_combat_length=0)
# Report           : 3237 - Demon Hunter Havoc.html (same folder; /r/ share links expire)
# Simmed           : 2026-10-28 by Fate
#
# BracketSim options (the full-buffed set of PROJECT.md; BracketSim hides buffs
# the class cannot use, so the visible list varies by class):
#   Raid buff preset: Optimal Raid Buffs
#   World buffs:   [ ] Flame Cap  [ ] Fengus' Ferocity  [ ] Slip'kik's Savvy
#                  [ ] Icecrown Citadel  [ ] Plague Stream
#                  [ ] Adventurer's Journal
#   Raid buffs:    [ ] Arcane Intellect  [x] Battle Shout
#                  [x] Mark of the Wild  [x] Skyfury  [x] Drums of Fury
#                  [x] Hunter's Mark  [ ] Blessing of the Bronze
#                  [ ] Power Word: Fortitude  [ ] Chaos Brand
#                  [ ] Mystic Touch  [ ] Bleeding  [ ] Power Infusion
#   Teammate armor reduction: none
#   Misc:          [x] Detailed SimC Report   [ ] Vary fight length
#                  [ ] Augmentation Evoker    [x] Stat weights
#
# Stat weights (DPS): Wdps 42.95 > Agi 9.53 > AP 9.06 > Vers 5.36 > Mastery 5.29 > Crit 5.20 > Haste 4.21
# ============================================================================

demonhunter="Fateberserkr"
source=default
region=us
server=thrall
spec=havoc
level=30
race=blood_elf
role=attack
position=back
professions=engineering=100/skinning=100
talents=CEkAAAAAAAAAAAAAAAAAAAAAAwAmZgZghJMGAAAAAAwsxAwAzAYGAzCAAQCMAAAAAAAAAAAAAAA

# Default consumables
potion=potion_of_the_tolvir
flask=flask_of_endless_rage
elixir=disabled
food=skewered_eel
augmentation=disabled
temporary_enchant=main_hand:adamantite_weightstone/off_hand:adamantite_weightstone

# Executed before combat begins. Accepts non-harmful actions only.
actions.precombat=snapshot_stats
actions.precombat+=/variable,name=tab_target_burning_wound,op=reset,default=1
actions.precombat+=/variable,name=rg_ds,default=0,op=reset
actions.precombat+=/variable,name=trinket1_special,value=0
actions.precombat+=/variable,name=trinket2_special,value=0
actions.precombat+=/variable,name=trinket1_crit,value=!variable.trinket1_special&trinket.1.has_cooldown&trinket.1.has_use_damage&!trinket.1.is.font_of_venomous_rage
actions.precombat+=/variable,name=trinket2_crit,value=!variable.trinket2_special&trinket.2.has_cooldown&trinket.2.has_use_damage&!trinket.1.is.font_of_venomous_rage
actions.precombat+=/variable,name=trinket1_steroids,value=!variable.trinket1_special&trinket.1.has_cooldown&trinket.1.has_use_buff
actions.precombat+=/variable,name=trinket2_steroids,value=!variable.trinket2_special&trinket.2.has_cooldown&trinket.2.has_use_buff
actions.precombat+=/immolation_aura

# Executed every time the actor is available.
actions=auto_attack
actions+=/retarget_auto_attack,line_cd=1,target_if=min:debuff.burning_wound.remains,if=talent.burning_wound&active_dot.burning_wound<(spell_targets>?3)&variable.tab_target_burning_wound
actions+=/retarget_auto_attack,line_cd=1,target_if=min:!target.is_boss,if=talent.burning_wound&active_dot.burning_wound=(spell_targets>?3)&variable.tab_target_burning_wound
actions+=/immolation_aura,if=talent.violent_transformation&talent.a_fire_inside&cooldown.metamorphosis.remains<gcd.max*3
actions+=/vengeful_retreat,use_off_gcd=1,if=gcd.remains<0.3&cooldown.metamorphosis.remains&cooldown.eye_beam.remains<gcd.max*0.3&!buff.initiative.up|cooldown.metamorphosis.up&cooldown.eye_beam.remains&cooldown.blade_dance.remains&!buff.eternal_hunt.up
actions+=/pick_up_fragment,type=all,use_off_gcd=1,if=fury<=40
actions+=/reavers_glaive,if=buff.rending_strike.down&buff.glaive_flurry.down
actions+=/call_action_list,name=items
actions+=/annihilation,if=buff.rending_strike.up&buff.glaive_flurry.down&debuff.reavers_mark.stack<2|buff.rending_strike.up&active_enemies>=2
actions+=/essence_break,if=action.death_sweep.demonsurge_available|action.annihilation.demonsurge_available
actions+=/death_sweep,if=debuff.essence_break.up|action.death_sweep.demonsurge_available
actions+=/annihilation,if=debuff.essence_break.up|action.annihilation.demonsurge_available
actions+=/immolation_aura,if=talent.a_fire_inside&talent.burning_wound&(charges=2|full_recharge_time<gcd.max*2)
actions+=/eye_beam
actions+=/throw_glaive,if=active_enemies>1&talent.burning_wound&!talent.screaming_brutality&active_dot.burning_wound<(spell_targets>?3)&!variable.tab_target_burning_wound
actions+=/immolation_aura,,if=action.immolation_aura.demonsurge_available&buff.demonsurge.remains<gcd.max
actions+=/abyssal_gaze,if=!action.death_sweep.demonsurge_available&!action.annihilation.demonsurge_available
actions+=/felblade,if=buff.inertia_trigger.up
actions+=/essence_break,if=cooldown.eye_beam.remains>4
actions+=/death_sweep
actions+=/blade_dance
actions+=/immolation_aura,if=active_enemies>1&(talent.a_fire_inside|talent.burning_wound)
actions+=/felblade,if=hero_tree.felscarred&fury<=100
actions+=/chaos_strike
actions+=/felblade
actions+=/metamorphosis,if=(!buff.metamorphosis.up|buff.metamorphosis.remains<gcd.max)&(!talent.chaotic_transformation|!cooldown.blade_dance.up&cooldown.eye_beam.remains>8)&!action.death_sweep.demonsurge_available&!action.annihilation.demonsurge_available
actions+=/the_hunt,if=(!talent.eternal_hunt|cooldown.eye_beam.remains<10&cooldown.metamorphosis.remains>15|!cooldown.eye_beam.up&cooldown.metamorphosis.up|!hero_tree.felscarred)&!buff.reavers_glaive.up
actions+=/immolation_aura
actions+=/annihilation
actions+=/arcane_torrent

actions.items=potion,use_off_gcd=1,if=cooldown.metamorphosis.up&(cooldown.eye_beam.up|!talent.chaotic_transformation)|fight_remains<=30
actions.items+=/use_item,slot=trinket1,use_off_gcd=1,if=variable.trinket1_steroids&(!variable.trinket2_special|trinket.2.cooldown.remains>20)|fight_remains<15
actions.items+=/use_item,slot=trinket1,use_off_gcd=1,if=variable.trinket1_crit&(buff.initiative.up|!talent.initiative)&(!variable.trinket2_special|trinket.2.cooldown.remains>20)|fight_remains<15
actions.items+=/use_item,name=font_of_venomous_rage,if=buff.initiative.up&buff.initiative.remains>2&(!buff.metamorphosis.up|fight_remains<buff.metamorphosis.remains)&!debuff.essence_break.up|fight_remains<19
actions.items+=/use_item,slot=trinket2,use_off_gcd=1,if=variable.trinket2_steroids&(!variable.trinket1_special|trinket.1.cooldown.remains>20)|fight_remains<15
actions.items+=/use_item,slot=trinket2,use_off_gcd=1,if=variable.trinket2_crit&(buff.initiative.up|!talent.initiative)&(!variable.trinket1_special|trinket.1.cooldown.remains>20)|fight_remains<15

head=wastewalker_helm,id=28224,bonus_id=7202,ilevel=33,gem_id=76884/213743/71852,enchant=6crit,drop_level=30
