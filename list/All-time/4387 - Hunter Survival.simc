main_hand=vibroblade,id=9485,bonus_id=6710,ilevel=33,enchant_id=4444,drop_level=30
off_hand=blade_of_the_unrequited,id=28572,bonus_id=9034,ilevel=38,gem_id=71852/71852/71852,enchant_id=4444,drop_level=30

