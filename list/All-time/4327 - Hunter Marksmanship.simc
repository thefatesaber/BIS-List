wrists=bracers_of_the_forest_stalker,id=34698,bonus_id=6652/7202/8810,ilevel=33,gem_id=32222/32222,enchant_id=3845,drop_level=30
hands=thalassian_ranger_gauntlets,id=34343,bonus_id=9037,ilevel=44,gem_id=32222/32222,enchant_id=5259,drop_level=30
waist=belt_of_dragons,id=45553,bonus_id=9043,ilevel=43,gem_id=32222/32222/32222,enchant_id=6904,drop_level=30
legs=wyrmscale_greaves,id=30534,bonus_id=6652/6710,ilevel=33,gem_id=32222/32222/32222,enchant_id=4880,drop_level=30
feet=starstrider_boots,id=29951,bonus_id=9035,ilevel=40,gem_id=32222/32222,enchant_id=1887
finger1=fleshfused_circle,id=178869,bonus_id=6652/6710/10386/10396/10879,ilevel=33,gem_id=32222/32222,enchant_id=6108,drop_level=30
finger2=seal_of_the_city_watch,id=162542,bonus_id=6652/6710/10386/10395/10879,ilevel=33,gem_id=32222/32222,enchant_id=6108,drop_level=30
trinket1=dragonspine_trophy,id=28830,bonus_id=9034,ilevel=38,drop_level=30
trinket2=herkuml_war_token,id=50355,ilevel=15
main_hand=falinrush_defender_of_quelthalas,id=50733,bonus_id=9051,ilevel=47,gem_id=32222,enchant_id=5950

