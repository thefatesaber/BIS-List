chest=merciless_gladiators_felweave_raiment,id=31982,bonus_id=9357,ilevel=45,gem_id=32218/32218/32218,enchant_id=6625,drop_level=30,content_tuning=2659
wrists=bracers_of_the_malefic,id=34436,bonus_id=9037,ilevel=44,gem_id=32218,enchant_id=2332,drop_level=30
hands=pharos_gloves,id=45665,bonus_id=9043,ilevel=43,gem_id=40155/40155,enchant_id=2937,drop_level=30
waist=belt_of_blasting,id=30038,bonus_id=9035,ilevel=40,gem_id=40155/40155/40155,drop_level=30
legs=leggings_of_calamity,id=34181,bonus_id=9037,ilevel=44,gem_id=40155/40155/40155,enchant_id=6541,drop_level=30
feet=treads_of_the_false_oracle,id=45537,bonus_id=9043,ilevel=43,gem_id=40155/40155,enchant_id=4092,drop_level=30
finger1=bloodoath_signet,id=178871,bonus_id=6652/6710/10386/10396/10879,ilevel=33,gem_id=40155/40155,enchant_id=6108,drop_level=30
finger2=band_of_the_ancient_dredger,id=159461,bonus_id=6652/6710/10386/10396/10879,ilevel=33,gem_id=40155/32196,enchant_id=6108,drop_level=30
trinket1=gale_of_shadows,id=56462,bonus_id=6652/6710,drop_level=30
trinket2=solace_of_the_fallen,id=47432,bonus_id=9047,ilevel=45
main_hand=abracadaver,id=51887,bonus_id=9049,ilevel=45,gem_id=40155/40155/40155,enchant_id=2669

