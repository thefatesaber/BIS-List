finger1=fleshfused_circle,id=178869,bonus_id=6652/6710/10386/10396/10879,ilevel=33,gem_id=71854/71854,enchant_id=6109,drop_level=30
finger2=signet_of_the_false_accuser,id=178824,bonus_id=6652/6710/10386/10396/10879,ilevel=33,gem_id=71854/71854,enchant_id=6109,drop_level=30
trinket1=gale_of_shadows,id=56462,bonus_id=6652/6710,drop_level=30
trinket2=solace_of_the_fallen,id=47432,bonus_id=9047,ilevel=45
main_hand=abracadaver,id=51887,bonus_id=9051,ilevel=45,gem_id=71854/71854/71854,enchant_id=2669,drop_level=30

