# ============================================================================
# Legacy Thirty BiS — All-time — Subtlety Rogue
# ----------------------------------------------------------------------------
# Engine of record : BracketSim (https://bracketsim.gg) — SimulationCraft 1210-01
#                    git e40a6d0, WoW 12.1.5.70575 hotfix 2026-10-28
# Result           : 2,565 DPS (±1.0 / 0.038%), 20015 iterations
#                    Patchwerk 300s, fixed length (vary_combat_length=0)
# Report           : 2565 - Rogue Subtlety.html (same folder; /r/ share links expire)
# Simmed           : 2026-10-28 by Fate
#
# BracketSim options (the full-buffed set of PROJECT.md; BracketSim hides buffs
# the class cannot use, so the visible list varies by class):
#   Raid buff preset: Optimal Raid Buffs
#   World buffs:   [ ] Flame Cap  [ ] Fengus' Ferocity  [ ] Slip'kik's Savvy
#                  [ ] Icecrown Citadel  [ ] Plague Stream
#                  [ ] Adventurer's Journal
#   Raid buffs:    [ ] Arcane Intellect  [x] Battle Shout
#                  [x] Mark of the Wild  [x] Skyfury  [x] Drums of Fury
#                  [x] Hunter's Mark  [ ] Blessing of the Bronze
#                  [ ] Power Word: Fortitude  [ ] Chaos Brand
#                  [ ] Mystic Touch  [ ] Bleeding  [ ] Power Infusion
#   Teammate armor reduction: none
#   Misc:          [x] Detailed SimC Report   [ ] Vary fight length
#                  [ ] Augmentation Evoker    [x] Stat weights
#
# Stat weights (DPS): Wdps 33.49 > Agi 7.26 > AP 6.83 > Haste 4.49 > Crit 4.46 > Vers 4.15 > Mastery 2.13
# ============================================================================

rogue="Fatesneak"
source=default
region=us
server=thrall
spec=subtlety
level=30
race=night_elf
timeofday=night
role=attack
position=back
talents=CUQA5HmDzx68KWyrW/8Y781L7DgBAAAAAALjBxstBGAgZWwCMjthZgBAGAAAAAAAAAAAAAgBA

# Default consumables
potion=potion_of_the_tolvir
flask=flask_of_endless_rage
elixir=disabled
food=skewered_eel
augmentation=disabled
temporary_enchant=main_hand:adamantite_sharpening_stone/off_hand:adamantite_sharpening_stone

# Executed before combat begins. Accepts non-harmful actions only.
actions.precombat=apply_poison
actions.precombat+=/snapshot_stats
actions.precombat+=/variable,name=priority_rotation,value=priority_rotation
actions.precombat+=/variable,name=trinket_sync_slot,value=1,if=trinket.1.has_use_buff&(!trinket.2.has_use_buff|trinket.1.cooldown.duration>=trinket.2.cooldown.duration)
actions.precombat+=/variable,name=trinket_sync_slot,value=2,if=trinket.2.has_use_buff&(!trinket.1.has_use_buff|trinket.2.cooldown.duration>trinket.1.cooldown.duration)
actions.precombat+=/stealth

# Executed every time the actor is available.
actions=thorn_bloom
actions+=/ancestral_call
actions+=/blood_fury
actions+=/variable,name=stealth,value=buff.shadow_dance.up|buff.stealth.up|buff.vanish.up
actions+=/variable,name=targets,value=spell_targets.shuriken_storm
actions+=/variable,name=racial_sync,value=(buff.shadow_blades.up&buff.shadow_dance.up)|!talent.shadow_blades|fight_remains<20
actions+=/variable,name=dance_condition,value=!variable.stealth&energy>=30&buff.slice_and_dice.up&(combo_points<=2|combo_points>=(6>?(cp_max_spend-1)))
actions+=/variable,name=build_at_max_for_apex,value=talent.ancient_arts_3&!buff.ancient_arts.up&buff.shadow_techniques.stack>=5
actions+=/stealth
actions+=/call_action_list,name=race
actions+=/call_action_list,name=item
actions+=/call_action_list,name=cds
actions+=/shuriken_storm,if=variable.build_at_max_for_apex&variable.targets>=3&(buff.supercharge_1.up|cooldown.secret_technique.ready)
actions+=/gloomblade,if=variable.build_at_max_for_apex&variable.targets<=2&(buff.darkest_night.up|(talent.unseen_blade&buff.supercharge_1.up)|cooldown.secret_technique.ready)&buff.lingering_shadow.stack>=35
actions+=/shadowstrike,if=variable.build_at_max_for_apex&variable.targets<=2&(buff.darkest_night.up|(talent.unseen_blade&buff.supercharge_1.up)|cooldown.secret_technique.ready)
actions+=/call_action_list,name=finish,if=combo_points>=cp_max_spend-!buff.darkest_night.up
actions+=/call_action_list,name=build,if=variable.stealth|energy>60
actions+=/call_action_list,name=fill,if=!variable.stealth

actions.build=shuriken_storm,if=buff.shadow_dance.up&buff.premeditation.up&(debuff.deathstalkers_mark.up|buff.darkest_night.up|!talent.deathstalkers_mark&(talent.unseen_blade|variable.targets>1))
actions.build+=/shadowstrike,if=!debuff.deathstalkers_mark.up&talent.deathstalkers_mark&!buff.darkest_night.up|variable.targets<=2-set_bonus.midnight_season_2_2pc|variable.priority_rotation
actions.build+=/shuriken_storm,if=variable.targets>1
actions.build+=/gloomblade,if=variable.targets<2&!variable.stealth
actions.build+=/backstab,if=variable.targets<2&!variable.stealth

actions.cds=goremaws_bite,if=buff.shadow_dance.up&!buff.ancient_arts.up|fight_remains<=14
actions.cds+=/shadow_blades,if=variable.dance_condition&cooldown.shadow_dance.charges_fractional>=0+0.8*talent.deathstalkers_mark&(buff.ancient_arts.up|!talent.unseen_blade)|(fight_remains<=20|target.time_to_die.remains<=20)
actions.cds+=/shadow_dance,if=variable.dance_condition&talent.deathstalkers_mark&(variable.targets<=3&(buff.darkest_night.up|cooldown.secret_technique.ready&debuff.deathstalkers_mark.stack<=1)|variable.targets>3&debuff.deathstalkers_mark.stack>=2)&(cooldown.shadow_blades.remains>=35-cooldown.secret_technique.duration)|(fight_remains<=10|target.time_to_die-remains<=9)
actions.cds+=/shadow_dance,if=variable.dance_condition&(cooldown.secret_technique.ready&(!talent.shadow_blades|cooldown.shadow_blades.remains>=25-cooldown.secret_technique.duration))|(fight_remains<=10|target.time_to_die-remains<=9)
actions.cds+=/shadow_dance,if=buff.shadow_blades.up&(talent.unseen_blade|variable.targets>=3)
actions.cds+=/vanish,if=!variable.stealth&energy>=50&!buff.subterfuge.up&combo_points<=2
actions.cds+=/shadowmeld,if=energy>=50&!variable.stealth&combo_points.deficit>=2

actions.fill=arcane_torrent,if=energy.deficit>=15+energy.regen
actions.fill+=/arcane_pulse
actions.fill+=/lights_judgment
actions.fill+=/bag_of_tricks

actions.finish=eviscerate,if=buff.darkest_night.up|!buff.slice_and_dice.up
actions.finish+=/secret_technique,if=buff.shadow_dance.up
actions.finish+=/secret_technique,if=talent.unseen_blade&cooldown.secret_technique.duration<18&!cooldown.shadow_dance.ready
actions.finish+=/coup_de_grace,if=cooldown.secret_technique.remains>=3|buff.shadow_dance.up
actions.finish+=/black_powder,if=talent.unseen_blade&variable.targets>=(3-talent.potent_powder)&(cooldown.secret_technique.remains>=3|buff.shadow_dance.up|buff.shadow_blades.up)
actions.finish+=/black_powder,if=talent.deathstalkers_mark&variable.targets>=2|!talent.unseen_blade&!talent.deathstalkers_mark&variable.targets>=3
actions.finish+=/eviscerate,if=cooldown.secret_technique.remains>=3|cooldown.shadow_dance.remains>=3|buff.shadow_dance.up|buff.shadow_blades.up|debuff.deathstalkers_mark.stack>1|debuff.deathstalkers_mark.stack=0&buff.shadow_techniques.stack>=5

actions.item=potion,if=buff.shadow_blades.up|fight_remains<30
actions.item+=/use_item,name=algethar_puzzle_box,if=cooldown.shadow_blades.ready&cooldown.secret_technique.remains<=2&combo_points>=6
actions.item+=/use_items,slots=trinket1,if=1|(variable.trinket_sync_slot=1&(buff.shadow_blades.up|fight_remains<=20)|(variable.trinket_sync_slot=2&(!trinket.2.cooldown.ready&cooldown.shadow_blades.remains>20))|!variable.trinket_sync_slot)
actions.item+=/use_items,slots=trinket2,if=1|(variable.trinket_sync_slot=2&(buff.shadow_blades.up|fight_remains<=20)|(variable.trinket_sync_slot=1&(!trinket.1.cooldown.ready&cooldown.shadow_blades.remains>20))|!variable.trinket_sync_slot)

actions.race=blood_fury,if=variable.racial_sync
actions.race+=/berserking,if=variable.racial_sync
actions.race+=/fireblood,if=variable.racial_sync
actions.race+=/ancestral_call,if=buff.shadow_blades.up
actions.race+=/invoke_external_buff,name=power_infusion,if=variable.racial_sync

head=frayed_scoundrels_cap,id=50206,bonus_id=6710,ilevel=33,gem_id=76884/213743/40150,drop_level=30
neck=tuskarr_bone_necklace,id=193666,bonus_id=6652/8782/9156/9477,ilevel=33,gem_id=213488/40150/40150,enchant_id=5437,drop_level=30
shoulders=mantle_of_perenolde,id=27434,bonus_id=6652/6710,ilevel=33,gem_id=40150/40150,enchant_id=3808,drop_level=30
back=drape_of_the_faceless_general,id=46032,bonus_id=9043,ilevel=43,gem_id=40150/40150,enchant_id=3243,drop_level=30
chest=midnight_chestguard,id=30905,bonus_id=9036,ilevel=42,gem_id=40150/40150/40150,enchant_id=6625,drop_level=30
