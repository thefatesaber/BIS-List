# ============================================================================
# Legacy Thirty BiS — All-time — Restoration Shaman (DPS twink)
# ----------------------------------------------------------------------------
# Engine of record : BracketSim (https://bracketsim.gg) — SimulationCraft 1210-01
#                    git 464f12e, WoW 12.1.5.70448 hotfix 2026-10-17
# Result           : 5,487 DPS (±1.3 / 0.025%), 20,011 iterations
#                    Patchwerk 300s, fixed length (vary_combat_length=0)
# Report           : shaman_restoration.html (same folder; /r/ share links expire)
# Simmed           : 2026-10-22 by Fate
#
# BracketSim options (identical across all three tiers — see PROJECT.md):
#   Raid buff preset: Optimal Raid Buffs
#   World buffs:   [x] Flame Cap (+21 fire SP, 60s every 180s)
#                  [ ] Slip'kik's Savvy  [ ] Icecrown Citadel  [ ] Plague Stream
#                  [ ] Adventurer's Journal
#   Raid buffs:    [x] Arcane Intellect  [x] Battle Shout  [x] Mark of the Wild
#                  [x] Skyfury (self)    [x] Drums of Fury (15% haste, 40s at pull)
#                  [x] Hunter's Mark (target, +3% damage taken)
#                  [ ] Blessing of the Bronze  [ ] Power Word: Fortitude
#                  [ ] Chaos Brand  [ ] Mystic Touch  [ ] Bleeding  [ ] Power Infusion
#   Teammate armor reduction: none
#   Misc:          [x] Detailed SimC Report   [ ] Vary fight length
#                  [ ] Augmentation Evoker    [x] Stat weights
#
# Stat weights (DPS): Int 14.92 > SP 14.05 > Haste 9.22 > Vers 8.56 ~= Crit 8.54
# ============================================================================

shaman="Broadcasting"
source=default
spec=restoration
region=us
server=thrall
level=30
race=orc
role=spell
position=back
talents=CgQALMl7AwW51MWzGneuHE3tPCAAAAAAAAAGLbMDYAwAAAAAAYGglHYgADMwmh5BAMAAAAAAADA

# Default consumables
potion=volcanic_potion
flask=flask_of_distilled_wisdom
elixir=disabled
food=severed_sagefish_head
augmentation=disabled
temporary_enchant=main_hand:superior_wizard_oil

# Executed before combat begins. Accepts non-harmful actions only.
actions.precombat=snapshot_stats
actions.precombat+=/lightning_shield

# Executed every time the actor is available.
actions=use_item,slot=trinket1
actions+=/use_item,slot=trinket2
actions+=/wind_shear
actions+=/lightning_shield,if=buff.lightning_shield.down
actions+=/healing_rain,line_cd=17,if=talent.acid_rain.enabled
actions+=/flame_shock,if=dot.flame_shock.refreshable
actions+=/blood_fury,if=dot.flame_shock.ticking
actions+=/berserking,if=dot.flame_shock.ticking
actions+=/fireblood,if=dot.flame_shock.ticking
actions+=/ancestral_call,if=dot.flame_shock.ticking
actions+=/ascendance,if=talent.preeminence.enabled&dot.flame_shock.ticking
actions+=/healing_tide_totem,if=talent.preeminence.enabled&dot.flame_shock.ticking
actions+=/potion,if=dot.flame_shock.ticking
actions+=/lava_burst,if=buff.lava_surge.up
actions+=/lava_burst,line_cd=6.5,if=buff.lava_surge.up|dot.flame_shock.ticking
actions+=/lightning_bolt
actions+=/flame_shock,moving=1,if=dot.flame_shock.refreshable
actions+=/frost_shock,moving=1

