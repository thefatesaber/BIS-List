feet=slayers_boots,id=34575,bonus_id=9043,ilevel=44,gem_id=40150,enchant_id=1887,drop_level=30
finger1=stitchfleshs_misplaced_signet,id=178736,bonus_id=6652/6710/10386/10396/10879,ilevel=33,gem_id=40150/40150,enchant_id=6109,drop_level=30
finger2=bloodoath_signet,id=178871,bonus_id=6652/6710/10386/10396/10879,ilevel=33,gem_id=40150/40150,enchant_id=6109,drop_level=30
trinket1=dragonspine_trophy,id=28830,bonus_id=9034,ilevel=38,drop_level=30
trinket2=chaos_talisman,id=137459,bonus_id=6652/6710,ilevel=33,drop_level=30
main_hand=heartrazor,id=29962,bonus_id=9035,ilevel=40,enchant_id=4099,drop_level=30,content_tuning=2659
