waist=belt_of_dragons,id=45553,bonus_id=9035,ilevel=43,gem_id=32194/32194/32194,drop_level=30
legs=wyrmscale_greaves,id=30534,bonus_id=6652/6710,ilevel=33,gem_id=32194/32194/32194,enchant_id=4880,drop_level=30
feet=starstrider_boots,id=29951,bonus_id=9035,ilevel=40,gem_id=32194/32194,enchant_id=1887,drop_level=30
finger1=seal_of_the_city_watch,id=162542,bonus_id=6652/6710/10386/10396/10879,ilevel=33,gem_id=32194/32194,enchant_id=6108,drop_level=30
finger2=bloodoath_signet,id=178871,bonus_id=6652/6710/10386/10396/10879,ilevel=33,gem_id=32194/32194,enchant_id=6108,drop_level=30
trinket1=dragonspine_trophy,id=28830,bonus_id=9034,ilevel=38,drop_level=30
