hands=hard_khorium_battlefists,id=34378,bonus_id=9037,ilevel=44,gem_id=71856/71856,enchant_id=4432,drop_level=30
waist=red_belt_of_battle,id=30032,bonus_id=9035,ilevel=40,gem_id=71856/71856/71856,drop_level=30
legs=felfury_legplates,id=34180,bonus_id=9037,ilevel=44,gem_id=71856/71856/71856,enchant_id=4881,drop_level=30
feet=dreadboots_of_the_legion,id=32345,bonus_id=9036,ilevel=42,gem_id=71856/71856,enchant_id=1597,drop_level=30
finger1=signet_of_the_false_accuser,id=178824,bonus_id=6652/6710/10386/10396/10879,ilevel=33,gem_id=71856/71856,enchant_id=6109,drop_level=30
finger2=archdruids_tainted_seal,id=134487,bonus_id=6652/6710/8810/10386,ilevel=47,gem_id=71856,enchant_id=6109,drop_level=30
