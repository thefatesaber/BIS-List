legs=moonchild_leggings,id=27492,ilevel=33,gem_id=71852/71852/71852,enchant_id=4880
feet=boots_of_the_shifting_sands,id=28339,ilevel=33,gem_id=71852/71852,enchant_id=1887
finger1=lavishly_jeweled_ring,id=1156,bonus_id=1808,ilevel=33,gem_id=71852,enchant_id=6110
finger2=band_of_flesh,id=13373,bonus_id=1808,ilevel=33,gem_id=71852,enchant_id=6108
trinket1=herkuml_war_token,id=50355,ilevel=15
trinket2=dragonspine_trophy,id=28830,ilevel=38
main_hand=eskhandars_right_claw,id=18203,ilevel=38,enchant_id=2673
off_hand=claw_of_the_watcher,id=27846,ilevel=33,gem_id=71852/71852,enchant_id=5950

