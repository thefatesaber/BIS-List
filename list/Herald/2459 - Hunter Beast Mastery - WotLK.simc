wrists=bracers_of_the_forest_stalker,id=34698,bonus_id=1808,ilevel=33,gem_id=71852/71852,enchant_id=3845
hands=gloves_of_quickening,id=28519,ilevel=38,gem_id=71852/71852,enchant_id=5259
waist=terror_pit_girdle,id=28778,ilevel=38,gem_id=71852/71852/71852
legs=wyrmscale_greaves,id=30534,ilevel=33,gem_id=71852/71852/71852,enchant_id=4880
feet=starstrider_boots,id=29951,ilevel=40,gem_id=71852/71852,enchant_id=1887
finger1=lavishly_jeweled_ring,id=1156,bonus_id=1808,ilevel=33,gem_id=71852,enchant_id=6108
finger2=charged_gear,id=9461,bonus_id=1808,ilevel=33,gem_id=71852,enchant_id=6108
trinket1=fury_of_the_five_flights,id=40431,ilevel=39
trinket2=herkuml_war_token,id=50355,ilevel=1
main_hand=arcanite_steampistol,id=29949,ilevel=40,enchant_id=6148

